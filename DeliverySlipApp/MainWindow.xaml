<Window x:Class="DeliverySlipApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:DeliverySlipApp.Models"
        xmlns:conv="clr-namespace:DeliverySlipApp.Converters"
        mc:Ignorable="d"
        Title="ガスボンベ充填伝票管理システム" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        FontFamily="Meiryo UI" FontSize="13">

    <Window.Resources>
        <conv:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,16,4"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,16,4"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,4,16,4"/>
        </Style>
        <Style TargetType="TextBox" x:Key="ReadOnlyField" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#ECECEC"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="Run" x:Key="RequiredMark">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="Text" Value=" *"/>
        </Style>
    </Window.Resources>

    <Grid Background="#DCE6EE">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C6E91" Padding="16,10">
            <TextBlock Text="ガスボンベ充填伝票管理システム" Foreground="White" FontSize="18" FontWeight="Bold"/>
        </Border>

        <Grid Grid.Row="1" Margin="16,16,16,8" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左側：伝票ヘッダー入力エリア -->
            <Border Grid.Column="0" Background="White" Padding="16" Margin="0,0,12,0" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Margin="0,0,0,8">
                            <Run Text="*" Foreground="Red" FontWeight="Bold"/><Run Text=" は必須項目です"/>
                        </TextBlock>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}">配送日<Run Style="{StaticResource RequiredMark}"/></TextBlock>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding DeliveryDate}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}">販売店<Run Style="{StaticResource RequiredMark}"/></TextBlock>
                            <ComboBox Grid.Column="3" ItemsSource="{Binding Stores}" SelectedItem="{Binding SelectedStore}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}">配送先<Run Style="{StaticResource RequiredMark}"/></TextBlock>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Destinations}" SelectedItem="{Binding SelectedDestination}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}">管理方法<Run Style="{StaticResource RequiredMark}"/></TextBlock>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <RadioButton Content="ボンベ" Margin="0,0,16,0" VerticalAlignment="Center"
                                             IsChecked="{Binding ManagementType, Converter={StaticResource StringEqualsConverter}, ConverterParameter=ボンベ}"/>
                                <RadioButton Content="メーター" VerticalAlignment="Center"
                                             IsChecked="{Binding ManagementType, Converter={StaticResource StringEqualsConverter}, ConverterParameter=メーター}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}">充填日<Run Style="{StaticResource RequiredMark}"/></TextBlock>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding FillingDate}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}">充填所<Run Style="{StaticResource RequiredMark}"/></TextBlock>
                            <ComboBox Grid.Column="3" ItemsSource="{Binding FillingStations}" SelectedItem="{Binding SelectedFillingStation}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}">納入数量<Run Style="{StaticResource RequiredMark}"/></TextBlock>
                            <TextBox Grid.Column="1" Text="{Binding DeliveredQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}">残数量<Run Style="{StaticResource RequiredMark}"/></TextBlock>
                            <TextBox Grid.Column="3" Text="{Binding RemainingQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Separator Margin="0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="検査ビン容量1" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{x:Static models:CapacityOption.All}"
                                      DisplayMemberPath="Display" SelectedValuePath="Value"
                                      SelectedValue="{Binding InspectionBinCapacity1}"/>
                            <TextBlock Grid.Column="2" Text="×" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="3" Width="70" Text="{Binding InspectionBinCount1, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="4" Text="本" Style="{StaticResource FieldLabel}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="検査ビン容量2" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{x:Static models:CapacityOption.All}"
                                      DisplayMemberPath="Display" SelectedValuePath="Value"
                                      SelectedValue="{Binding InspectionBinCapacity2}"/>
                            <TextBlock Grid.Column="2" Text="×" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="3" Width="70" Text="{Binding InspectionBinCount2, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="4" Text="本" Style="{StaticResource FieldLabel}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="検査ビン容量3" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{x:Static models:CapacityOption.All}"
                                      DisplayMemberPath="Display" SelectedValuePath="Value"
                                      SelectedValue="{Binding InspectionBinCapacity3}"/>
                            <TextBlock Grid.Column="2" Text="×" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="3" Width="70" Text="{Binding InspectionBinCount3, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="4" Text="本" Style="{StaticResource FieldLabel}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="検査ビン容量計" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource ReadOnlyField}" Text="{Binding InspectionBinCapacityTotalDisplay, Mode=OneWay}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="検査ビン残数量" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding InspectionBinRemaining, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="2" Text="検査ビン使用量" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="3" Style="{StaticResource ReadOnlyField}" Text="{Binding InspectionBinUsageDisplay, Mode=OneWay}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="充填数量" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource ReadOnlyField}" Text="{Binding FillingQuantityDisplay, Mode=OneWay}"/>
                            <TextBlock Grid.Column="2" Text="うち耐圧充填量" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="3" Text="{Binding PressureFillingAmount, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBlock Text="備考" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右側：ボンベ情報明細一覧 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" Padding="8" CornerRadius="4">
                    <DataGrid ItemsSource="{Binding CylinderRows}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Symbol, UpdateSourceTrigger=PropertyChanged}" Width="90">
                                <DataGridTextColumn.Header>
                                    <TextBlock>ボンベ記号<Run Style="{StaticResource RequiredMark}"/></TextBlock>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Number, UpdateSourceTrigger=PropertyChanged}" Width="90">
                                <DataGridTextColumn.Header>
                                    <TextBlock>ボンベ番号<Run Style="{StaticResource RequiredMark}"/></TextBlock>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock>容量<Run Style="{StaticResource RequiredMark}"/></TextBlock>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{x:Static models:CapacityOption.All}"
                                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Capacity, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0" BorderThickness="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="120">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock>引渡/引取<Run Style="{StaticResource RequiredMark}"/></TextBlock>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="引渡" Margin="2,0"
                                                         IsChecked="{Binding DeliveryType, Converter={StaticResource StringEqualsConverter}, ConverterParameter=引渡}"/>
                                            <RadioButton Content="引取" Margin="6,0,2,0"
                                                         IsChecked="{Binding DeliveryType, Converter={StaticResource StringEqualsConverter}, ConverterParameter=引取}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridCheckBoxColumn Header="検査ビン" Binding="{Binding InspectionBin}" Width="70"/>
                            <DataGridCheckBoxColumn Header="耐圧ビン" Binding="{Binding PressureBin}" Width="70"/>

                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑" Padding="4,0" BorderThickness="0" Background="Transparent"
                                                Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="＋ 項目の追加" Padding="12,6" Command="{Binding AddRowCommand}"/>
                    <Button Grid.Column="2" Content="登録" Padding="32,8" FontSize="15" FontWeight="Bold"
                            Background="#E08E45" Foreground="White" BorderThickness="0"
                            Command="{Binding RegisterCommand}"/>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="White" Padding="16,10" Margin="16,0,16,16" CornerRadius="4">
            <Button Content="Excel出力" Padding="20,8" HorizontalAlignment="Left" Click="ExcelExportButton_Click"/>
        </Border>
    </Grid>
</Window>
